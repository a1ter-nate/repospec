{
  "name": "repospec",
  "version": "5.0.1",
  "type": "module",
  "description": "Deterministic canonical RepoSpec IR (OpenAPI for architecture, tests, CI, IaC, governance, and code-quality rules) with SQLite graph index and interactive visual studio.",
  "license": "MIT",
  "homepage": "https://github.com/a1ter-nate/repospec#readme",
  "bugs": {
    "url": "https://github.com/a1ter-nate/repospec/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a1ter-nate/repospec.git"
  },
  "keywords": [
    "architecture",
    "static-analysis",
    "code-graph",
    "sqlite",
    "invariants",
    "dependency-graph",
    "openapi",
    "dsm",
    "bun"
  ],
  "bin": {
    "repospec": "bin/repospec.mjs"
  },
  "workspaces": [
    "packages/*",
    "packages/plugins/*"
  ],
  "exports": {
    ".": "./dist/core/index.mjs",
    "./plugin": "./dist/plugin/index.mjs",
    "./plugin/effect": "./dist/plugin/effect.mjs",
    "./core": "./dist/core/index.mjs",
    "./core/facts": "./dist/core/facts.mjs",
    "./core/eject": "./dist/core/eject.mjs",
    "./core/effect": "./dist/core/effect.mjs",
    "./cli": "./dist/cli/index.mjs",
    "./report": "./dist/report/index.mjs",
    "./show-me": "./dist/show-me/index.mjs",
    "./show-me/svg": "./dist/show-me/svg.mjs",
    "./ci": "./dist/ci/index.mjs",
    "./flows": "./dist/flows/index.mjs",
    "./flows/svg": "./dist/flows/svg.mjs",
    "./flows/languages": "./dist/flows/languages.mjs",
    "./perf": "./dist/perf/index.mjs",
    "./perf/algorithms": "./dist/perf/algorithms.mjs",
    "./perf/data-structures": "./dist/perf/data-structures.mjs"
  },
  "files": [
    "bin/",
    "dist/",
    "rules/",
    "config/",
    "skills/",
    "docs/language-plugin-spec.md",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "build": "bun tools/build.ts",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:packages": "bun test ./packages/",
    "test:plugins": "bun test ./packages/plugins/",
    "format": "bunx oxfmt src packages tests",
    "format:check": "bunx oxfmt --check src packages tests",
    "lint:oxlint": "bunx oxlint -c .oxlintrc.json --deny-warnings src packages tests",
    "lint:privacy": "bun -e 'const r = Bun.spawnSync([\"git\", \"grep\", \"-nE\", \"(/Users/[A-Za-z0-9._-]+|C:\\\\\\\\Users\\\\\\\\[A-Za-z0-9._-]+|ghp_[A-Za-z0-9]{20,}|AKIA[0-9A-Z]{16})\", \"--\", \"src\", \"packages\", \"tests\", \"rules\", \"config\", \"skills\", \"README.md\", \":!tests/fixtures/\"]); const out = r.stdout.toString().trim(); if (out) { console.error(\"Privacy audit failed:\\n\" + out); process.exit(1); }'",
    "lint:ts-only": "bun -e 'import { Glob } from \"bun\"; const bad = [...new Glob(\"{src,packages,tests}/**/*.{js,mjs,cjs,jsx}\").scanSync(\".\")]; if (bad.length > 0) { console.error(\"Non-TypeScript files found:\\n\" + bad.join(\"\\n\")); process.exit(1); }'",
    "lint:no-comments": "bunx vstack no-comments . --fail",
    "lint:state-machines": "bunx vstack state-machines . --fail",
    "lint:laws": "bunx vstack laws . --verify --fail",
    "lint:formal-sync": "bunx vstack formal-sync . --fail",
    "lint:bench": "bunx vstack bench . --corpus src --fail",
    "lint:diff-cheats": "bunx vstack diff-cheats . --base HEAD --fail",
    "perf:check": "bun tools/check-perf-budget.ts",
    "check:vstack": "bun run lint:oxlint && bun run lint:privacy && bun run lint:ts-only && bun run lint:no-comments && bun run lint:state-machines && bun run lint:laws && bun run lint:formal-sync && bun run lint:bench && bun run perf:check && bunx vstack scan . --strict && bunx vstack doctor . --fail",
    "generate": "bun src/cli.ts generate",
    "schema": "bun src/cli.ts schema",
    "check:features": "bunx featlock check .",
    "check": "bun run typecheck && bun test && bun run check:vstack"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.4",
    "@effect/platform-bun": "^4.1.6",
    "@effect/sql-sqlite-bun": "^4.1.6",
    "effect": "^4.1.6",
    "js-yaml": "^4.1.0",
    "typescript": "^5.8.2"
  },
  "optionalDependencies": {
    "@resvg/resvg-js": "^2.6.2"
  },
  "devDependencies": {
    "@interfere/landmines": "^0.3.1",
    "@oxlint/plugins": "1.95.0",
    "@types/bun": "latest",
    "@types/dagre": "^0.7.54",
    "@types/js-yaml": "^4.0.9",
    "fast-check": "^4.11.0",
    "featlock": "github:a1ter-nate/featlock#v0.1.0-pre",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "veristack": "^0.1.19"
  }
}
